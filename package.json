{
  "name": "mapequation-demo",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/mapequation/map-demo",
  "homepage": "http://mapequation.org/demo",
  "license": "MIT",
  "author": "Anton Eriksson, Daniel Edler",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "react-spring-issue-1078": "find node_modules -path \\*@react-spring/\\*/package.json -exec sed -i.bak 's/\"sideEffects\": false/\"sideEffects\": true/g' {} +",
    "postinstall": "npm run react-spring-issue-1078",
    "deploy": "npm run build && scp -r dist/* mapequation:/var/www/demo"
  },
  "dependencies": {
    "@matejmazur/react-katex": "^3.1.3",
    "d3": "^7.2.0",
    "katex": "^0.15.1",
    "mobx": "^6.3.8",
    "mobx-react": "^7.2.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-spring": "^9.3.2"
  },
  "devDependencies": {
    "@types/d3": "^7.1.0",
    "@types/katex": "^0.11.1",
    "@types/react": "^17.0.37",
    "@types/react-dom": "^17.0.11",
    "@vitejs/plugin-react-refresh": "^1.3.6",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.4",
    "prettier": "^2.5.1",
    "prop-types": "^15.7.2",
    "tailwindcss": "^2.2.19",
    "typescript": "^4.5.2",
    "vite": "^2.7.1"
  }
}
